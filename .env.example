# Settings Alibi reads from the environment (see src/ittravel/settings.py). All are optional.
# Set them in your host (Vercel project settings, docker-compose, or your shell). Never commit real values.

# Master key for /v1/auth/evaluate, /v1/anomalies, /v1/stats and /v1/keys/generate.
# Unset = those endpoints return 503. The dashboard and /v1/demo/check never need it.
ALIBI_API_KEY=

# Speed between two sign-ins (km/h) above which travel counts as impossible. Default 900.
ALIBI_VELOCITY_THRESHOLD=900

# Set to 1 to never fetch the Tor Project's live exit list (tests do this).
ALIBI_OFFLINE=

# How many proxies in front of the app add to X-Forwarded-For (used for per-IP rate limits).
# Default 0: the header is ignored, so a client can't pick its own bucket. Vercel is detected and counts as 1.
# Set 1 behind one reverse proxy such as nginx or a load balancer.
ALIBI_TRUSTED_PROXY_HOPS=
