# Settings Alibi reads from the environment. All are optional.
# Set them in your host (Vercel project settings, docker-compose, or your shell). Never commit real values.

# Set to 1 to run offline and never fetch the Tor Project's live exit list (tests do this).
ALIBI_OFFLINE=

# How many proxies in front of the app add to X-Forwarded-For (used for per-IP rate limits).
# Default 0: the header is ignored, so a client can't pick its own bucket. Vercel is auto-detected and counts as 1.
# Set 1 behind one reverse proxy such as nginx, Cloudflare, or an AWS ALB.
ALIBI_TRUSTED_PROXY_HOPS=
